# ============================================
# HAGGO - PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# 
# IMPORTANTE: Este es un archivo de ejemplo
# Copia este archivo como .env.production y completa con valores reales
# NUNCA commitees .env.production al repositorio
#
# ============================================

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/haggo_prod?schema=public"

# Para Vercel Postgres (si aplica)
POSTGRES_PRISMA_URL="postgresql://user:password@host/database?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/database"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# Generar con: openssl rand -base64 32
# CRÍTICO: Debe ser único y secreto
NEXTAUTH_SECRET="CAMBIAR_POR_SECRET_GENERADO_CON_OPENSSL"

# URL de la aplicación en producción
NEXTAUTH_URL="https://tu-dominio.com"

# Configuración de sesiones (opcional)
SESSION_MAX_AGE="86400"        # 24 horas en segundos
SESSION_UPDATE_AGE="3600"      # 1 hora en segundos

# ============================================
# MERCADOPAGO
# ============================================
# Access Token de producción de MercadoPago
# Obtener desde: https://www.mercadopago.com.co/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN="APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Secret para validar webhooks de MercadoPago
# Configurar en: https://www.mercadopago.com.co/developers/panel/webhooks
MERCADOPAGO_WEBHOOK_SECRET="tu_webhook_secret_aqui"

# ============================================
# CLOUDINARY (Almacenamiento de imágenes)
# ============================================
# Obtener desde: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="tu_api_secret_aqui"

# ============================================
# PUSH NOTIFICATIONS (Web Push)
# ============================================
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="tu_vapid_public_key_aqui"
VAPID_PRIVATE_KEY="tu_vapid_private_key_aqui"

# Email para contacto de notificaciones
VAPID_SUBJECT="mailto:contacto@tu-dominio.com"

# ============================================
# APPLICATION
# ============================================
# Ambiente de ejecución
NODE_ENV="production"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME="Haggo"

# ============================================
# LOGGING
# ============================================
# Nivel de logs: error, warn, info, debug
LOG_LEVEL="info"

# ============================================
# RATE LIMITING (Opcional - para Upstash Redis)
# ============================================
# Si usas Upstash Redis para rate limiting distribuido
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# ============================================
# MONITORING (Opcional)
# ============================================
# Sentry para error tracking
# NEXT_PUBLIC_SENTRY_DSN="https://..."
# SENTRY_AUTH_TOKEN="..."

# ============================================
# EMAIL (Opcional - para notificaciones)
# ============================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASSWORD="tu_app_password"
# SMTP_FROM="noreply@tu-dominio.com"

# ============================================
# ANALYTICS (Opcional)
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ============================================
# SECURITY
# ============================================
# Allowed origins for CORS (separados por coma)
ALLOWED_ORIGINS="https://tu-dominio.com,https://www.tu-dominio.com"

# Cloudflare Turnstile (anti-bot para login/registro)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA...secret"
SECURITY_INTERNAL_TOKEN="token-interno-largo-y-aleatorio"

# ============================================
# FEATURE FLAGS (Opcional)
# ============================================
# ENABLE_MAINTENANCE_MODE="false"
# ENABLE_REGISTRATION="true"
# ENABLE_PAYMENTS="true"

# ============================================
# BACKUP & RECOVERY (Opcional)
# ============================================
# S3_BACKUP_BUCKET="haggo-backups"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="us-east-1"

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. SEGURIDAD:
#    - Nunca compartas este archivo con valores reales
#    - Usa secretos únicos para cada ambiente
#    - Rota secretos regularmente (cada 90 días)
#    - Usa gestores de secretos en producción (AWS Secrets Manager, etc)
#
# 2. VALIDACIÓN:
#    - Ejecuta: npm run validate-env antes de deployment
#    - Verifica que todas las variables requeridas estén configuradas
#
# 3. BACKUP:
#    - Mantén backup seguro de estas variables
#    - Documenta dónde están almacenadas en producción
#
# 4. DEPLOYMENT:
#    - En Vercel: Configurar en Project Settings > Environment Variables
#    - En AWS: Usar Parameter Store o Secrets Manager
#    - En Docker: Usar secrets de Docker o variables de entorno
#
# ============================================
