# Base de datos PostgreSQL
# Reemplaza 'usuario', 'contraseña' y 'servicios_db' con tus credenciales
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/servicios_db"

# NextAuth Secret (genera uno nuevo con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui-cambialo"
NEXTAUTH_SECRET_CURRENT="tu-secreto-actual"

# Configuración de sesión (en segundos)
SESSION_MAX_AGE="86400"
SESSION_UPDATE_AGE="3600"

# URL de la aplicación
NEXTAUTH_URL="http://localhost:3000"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN="tu-access-token"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="tu-public-key"
MERCADOPAGO_WEBHOOK_SECRET="tu-webhook-secret"

# Cloudinary (opcional - para producción en Vercel)
# Configuración de Cloudinary / Cloudinary Configuration
# IMPORTANT: Rotate these credentials every 30 days
# Última rotación / Last rotation: [Añade la fecha cuando la gires / Add the date when rotating]
# Obtén estas credenciales en https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Push Notifications Configuration
# Generate keys with: npx web-push generate-vapid-keys
# IMPORTANT: Rotate every 90 days
# Last rotation: [Add date when rotating]
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key

# Anti-bot (Cloudflare Turnstile) - recomendado para producción
# Crear en https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="tu-turnstile-site-key"
TURNSTILE_SECRET_KEY="tu-turnstile-secret-key"

# Token interno para telemetría y bloqueo de IP desde middleware (usar valor largo y aleatorio)
SECURITY_INTERNAL_TOKEN="tu-security-internal-token"
