# Base de datos PostgreSQL
# Reemplaza 'usuario', 'contraseña' y 'servicios_db' con tus credenciales
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/servicios_db"

# NextAuth Secret (genera uno nuevo con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui-cambialo"
NEXTAUTH_SECRET_CURRENT="tu-secreto-actual"

# Configuración de sesión (en segundos)
SESSION_MAX_AGE="86400"
SESSION_UPDATE_AGE="3600"

# URL de la aplicación
NEXTAUTH_URL="http://localhost:3000"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN="tu-access-token"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="tu-public-key"
MERCADOPAGO_WEBHOOK_SECRET="tu-webhook-secret"

# Cloudinary (opcional - para producción en Vercel)
# Obtén estas credenciales en https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
