# Files NOT uploaded to Vercel build environment (saves bandwidth + avoids leaking dev config).
# Note: .gitignore already excludes these from the repo, but defense in depth.

# Claude Code local config (subagents, slash commands, hooks)
.claude/

# IDE config
.vscode/
.idea/

# Local documentation (contains test credentials)
PROJECT.md
CLAUDE.md

# Test artifacts
.playwright-mcp/
playwright-report/
test-results/

# Local SQL scratch files (but NOT prisma migrations — those must stay in build env)
docs/sql/
sql-migrations/

# NOTE: scripts/vercel-should-build.sh is NOT ignored — Vercel's ignoreCommand needs it.
