# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dvby4cpma

# Google Maps API Key (for geolocation features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BD_7s76vg5XSr0M4-Btqpd5Tk8hP5sJ2LA8dF9ZyXWlCJ6J_0Eno9XSfS4zwXoYLI15yVoBuWzXgaiJtGbbAAx4

# Firebase Configuration (for push notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# MercadoPago Configuration
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-62909c37-3d5e-4c97-8ac3-e5d06045c9b4

# App Configuration
NEXT_PUBLIC_APP_NAME=LoHaggo
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_BUILD=1

# Deep Linking
NEXT_PUBLIC_DEEP_LINK_SCHEME=lohaggo
NEXT_PUBLIC_UNIVERSAL_LINK_DOMAIN=lohaggo.com

# Feature Flags
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_GEOLOCATION=true
NEXT_PUBLIC_ENABLE_CAMERA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# Analytics (Optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Sentry (Optional - for error tracking)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
