NEXT_PUBLIC_APP_URL=https://www.lohaggo.com

# Supabase Configuration (Add your production Supabase credentials)
NEXT_PUBLIC_SUPABASE_URL=https://iqxqxqxqxqxqxqxqxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlxeHF4cXhxeHF4cXhxeHF4cXhxeHF4cXhxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzQzNzI2NzAsImV4cCI6MjA0OTk0ODY3MH0.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NextAuth Configuration
NEXTAUTH_URL=https://www.lohaggo.com
