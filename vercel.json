{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-should-build.sh",
  "crons": [
    {
      "path": "/api/pwa/cron/adoption-alerts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/messaging/run-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/notification-reminders",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/meta-pending",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/ai-maintenance",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/copilot",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/publisher",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/marketing-metrics",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/channel-health",
      "schedule": "0 11 * * *"
    }
  ]
}
