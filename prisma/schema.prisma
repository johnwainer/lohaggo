generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Achievement {
  id                 String               @id
  type               AchievementType      @unique
  name               String
  description        String
  icon               String
  level              Int                  @default(1)
  createdAt          DateTime             @default(now())
  PartnerAchievement PartnerAchievement[]
}

model Address {
  id           String   @id
  userId       String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         City
  postalCode   String?
  instructions String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isPrimary])
}

model Availability {
  id               String          @id
  partnerId        String
  partnerServiceId String?
  dayOfWeek        Int
  startTime        String
  endTime          String
  active           Boolean         @default(true)
  PartnerProfile   PartnerProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  PartnerService   PartnerService? @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String          @id
  userId                String
  serviceId             String
  partnerId             String?
  scheduledDate         DateTime
  scheduledTime         String
  address               String
  notes                 String?
  city                  City            @default(MEDELLIN)
  status                BookingStatus   @default(PENDING)
  totalPrice            Float
  clientCommissionRate  Float?
  partnerCommissionRate Float?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  proposalId            String?
  PartnerProfile        PartnerProfile? @relation(fields: [partnerId], references: [id])
  Proposal              Proposal?       @relation(fields: [proposalId], references: [id])
  Service               Service         @relation(fields: [serviceId], references: [id])
  User                  User            @relation(fields: [userId], references: [id])
  Payment               Payment?
  Review                Review?
}

model Category {
  id          String    @id
  name        String
  slug        String    @unique
  icon        String
  description String?
  order       Int       @default(0)
  Service     Service[]
}

model Chat {
  id               String         @id
  serviceRequestId String
  proposalId       String         @unique
  clientId         String
  partnerId        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  User             User           @relation(fields: [clientId], references: [id])
  PartnerProfile   PartnerProfile @relation(fields: [partnerId], references: [id])
  Proposal         Proposal       @relation(fields: [proposalId], references: [id])
  ServiceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  ChatMessage      ChatMessage[]

  @@unique([serviceRequestId, clientId, partnerId])
  @@index([clientId])
  @@index([partnerId])
  @@index([serviceRequestId])
}

model ChatMessage {
  id        String   @id
  chatId    String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  Chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
}

model CityConfig {
  id               String     @id
  name             String     @unique
  slug             String     @unique
  order            Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime
  fechaLanzamiento DateTime?
  lanzamiento      Boolean    @default(false)
  latitude         Float?
  longitude        Float?
  status           CityStatus @default(ACTIVE)
}

model Notification {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  message   String
  data      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  User      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, read])
}

model PartnerAchievement {
  id             String         @id
  partnerId      String
  achievementId  String
  unlockedAt     DateTime       @default(now())
  Achievement    Achievement    @relation(fields: [achievementId], references: [id])
  PartnerProfile PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, achievementId])
  @@index([partnerId])
}

model PartnerProfile {
  id                   String                 @id
  userId               String                 @unique
  bio                  String?
  rating               Float                  @default(0)
  totalReviews         Int                    @default(0)
  verified             Boolean                @default(false)
  city                 City                   @default(MEDELLIN)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Availability         Availability[]
  Booking              Booking[]
  Chat                 Chat[]
  PartnerAchievement   PartnerAchievement[]
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  PartnerService       PartnerService[]
  Payout               Payout[]
  Proposal             Proposal[]
  VerificationDocument VerificationDocument[]
}

model PartnerService {
  id             String         @id
  partnerId      String
  serviceId      String
  price          Float
  city           City           @default(MEDELLIN)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  Availability   Availability[]
  PartnerProfile PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  Service        Service        @relation(fields: [serviceId], references: [id])

  @@unique([partnerId, serviceId])
}

model Payment {
  id                   String         @id
  bookingId            String         @unique
  userId               String
  paymentMethodId      String?
  mercadopagoId        String?        @unique
  preferenceId         String?
  amount               Float
  serviceAmount        Float
  clientCommission     Float
  clientCommissionRate Float
  totalAmount          Float
  status               PaymentStatus  @default(PENDING)
  paymentMethodType    String?
  paymentType          String?
  transactionAmount    Float?
  netReceivedAmount    Float?
  mercadopagoFee       Float?
  metadata             String?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime
  Booking              Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  PaymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  User                 User           @relation(fields: [userId], references: [id])
  Payout               Payout?

  @@index([mercadopagoId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([userId])
}

model PaymentConfig {
  id                     String             @id
  environment            PaymentEnvironment @default(TEST)
  testAccessToken        String?
  testPublicKey          String?
  productionAccessToken  String?
  productionPublicKey    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  productionClientId     String?
  productionClientSecret String?
  testClientId           String?
  testClientSecret       String?
}

model PaymentMethod {
  id                String    @id
  userId            String
  mercadopagoCardId String?   @unique
  cardToken         String?
  lastFourDigits    String
  cardBrand         String
  cardholderName    String
  expirationMonth   Int
  expirationYear    Int
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Payment           Payment[]
  User              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mercadopagoCardId])
  @@index([userId])
}

model Payout {
  id                    String         @id
  paymentId             String         @unique
  partnerId             String
  amount                Float
  partnerCommission     Float
  partnerCommissionRate Float
  netAmount             Float
  status                PayoutStatus   @default(PENDING)
  processedBy           String?
  processedAt           DateTime?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  PartnerProfile        PartnerProfile @relation(fields: [partnerId], references: [id])
  Payment               Payment        @relation(fields: [paymentId], references: [id])

  @@index([partnerId])
  @@index([paymentId])
  @@index([status])
}

model PlatformConfig {
  id                    String   @id
  key                   String   @unique
  commissionRate        Float
  clientCommissionRate  Float    @default(5.0)
  partnerCommissionRate Float    @default(10.0)
  minServicePrice       Float
  maxServicePrice       Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  @@index([key])
}

model Proposal {
  id               String         @id
  serviceRequestId String
  partnerId        String
  price            Float
  notes            String?
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  Booking          Booking[]
  Chat             Chat?
  PartnerProfile   PartnerProfile @relation(fields: [partnerId], references: [id])
  ServiceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@unique([serviceRequestId, partnerId])
}

model RequestPhoto {
  id               String         @id
  serviceRequestId String
  url              String
  publicId         String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  ServiceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model Review {
  id                     String    @id
  bookingId              String    @unique
  clientToPartnerRating  Int?
  clientToPartnerComment String?
  clientReviewedAt       DateTime?
  partnerToClientRating  Int?
  partnerToClientComment String?
  partnerReviewedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  Booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Service {
  id             String           @id
  name           String
  slug           String           @unique
  description    String
  icon           String
  categoryId     String
  basePrice      Float
  duration       Int
  popular        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Booking        Booking[]
  PartnerService PartnerService[]
  Category       Category         @relation(fields: [categoryId], references: [id])
  ServiceRequest ServiceRequest[]
}

model ServiceRequest {
  id            String               @id
  userId        String
  serviceId     String
  address       String
  notes         String?
  city          City                 @default(MEDELLIN)
  preferredDate DateTime?
  preferredTime String?
  isUrgent      Boolean              @default(false)
  status        ServiceRequestStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime
  Chat          Chat[]
  Proposal      Proposal[]
  RequestPhoto  RequestPhoto[]
  Service       Service              @relation(fields: [serviceId], references: [id])
  User          User                 @relation(fields: [userId], references: [id])
}

model User {
  id                    String           @id
  email                 String           @unique
  name                  String
  password              String
  phone                 String?
  image                 String?
  role                  UserRole         @default(CLIENT)
  pushSubscription      String?
  clientRating          Float            @default(0)
  clientTotalReviews    Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  mercadopagoCustomerId String?          @unique
  Address               Address[]
  Booking               Booking[]
  Chat                  Chat[]
  Notification          Notification[]
  PartnerProfile        PartnerProfile?
  Payment               Payment[]
  PaymentMethod         PaymentMethod[]
  ServiceRequest        ServiceRequest[]
}

model VerificationDocument {
  id              String         @id
  partnerId       String
  type            DocumentType
  documentUrl     String
  publicId        String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  PartnerProfile  PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([status])
}

enum AchievementType {
  IDENTITY_VERIFIED
  EDUCATION_VERIFIED
  BACKGROUND_CHECK_VERIFIED
  FIRST_SERVICE
  TEN_SERVICES
  FIFTY_SERVICES
  HUNDRED_SERVICES
  FIVE_STAR_RATING
  VERIFIED_PARTNER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum City {
  MEDELLIN
  BOGOTA
  CALI
  BARRANQUILLA
}

enum CityStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  CEDULA_CIUDADANIA
  CEDULA_EXTRANJERIA
  PASAPORTE
  PEP
  DIPLOMA_BACHILLERATO
  DIPLOMA_TECNICO
  DIPLOMA_TECNOLOGO
  DIPLOMA_PROFESIONAL
  DIPLOMA_POSGRADO
  CERTIFICADO_CURSO
  ANTECEDENTES
}

enum NotificationType {
  NEW_SERVICE_REQUEST
  NEW_PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  ACHIEVEMENT_UNLOCKED
  NEW_MESSAGE
}

enum PaymentEnvironment {
  TEST
  PRODUCTION
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ServiceRequestStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum UserRole {
  CLIENT
  PARTNER
  ADMIN
}
