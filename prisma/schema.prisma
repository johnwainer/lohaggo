  @@index([token])
  @@index([userId])
}

// ─── AI agents ───────────────────────────────────────────────────────────────

/// Platform-wide AI provider settings (singleton row id = "platform"). Keys are AES-256-GCM encrypted.
model AiSettings {
  id                      String    @id @default("platform")
  anthropicKeyEncrypted   String?
  voyageKeyEncrypted      String?
  defaultModel            String    @default("claude-opus-5")
  fallbackModel           String    @default("claude-haiku-4-5")
  embeddingModel          String    @default("voyage-3")
  allowAgentModelOverride Boolean   @default(false)
  auxDailyBudgetUsd       Float     @default(5)
  modelsCache             Json?
  modelsCachedAt          DateTime?
  defaultModelCheckedAt   DateTime?
  defaultModelCheckOk     Boolean?
  openaiKeyEncrypted      String?
  openaiModel             String?
  openaiFallbackModel     String?
  openaiModelsCache       Json?
  openaiModelsCachedAt    DateTime?
  providerOrder           String    @default("anthropic,openai")
  failoverEnabled         Boolean   @default(true)
  updatedByEmail          String?
  updatedAt               DateTime  @updatedAt
}

/// Circuit breaker per text-AI provider: while `down` and before `downUntil`, calls skip it.
model AiProviderState {
  provider    String    @id
  status      String    @default("ok")
  reason      String?
  detail      String?
  downUntil   DateTime?
  lastErrorAt DateTime?
  lastOkAt    DateTime?
  failures    Int       @default(0)
  notifiedAt  DateTime?
  updatedAt   DateTime  @updatedAt
}

model AiPricing {
  id                String   @id @default(cuid())
  provider          String
  model             String
  inputPerMTok      Float
  outputPerMTok     Float
  cacheReadPerMTok  Float    @default(0)
  cacheWritePerMTok Float    @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([provider, model])
}

model AiCall {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  period           String
  provider         String
  model            String
  requestedModel   String?
  kind             String
  workspaceId      String?
  agentId          String?
  conversationId   String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  latencyMs        Int?

  @@index([period, workspaceId])
  @@index([agentId, createdAt])
  @@index([createdAt])
  @@map("ai_calls")
}

model AiAgent {
  id                         String    @id @default(cuid())
  workspaceId                String
  name                       String
  avatar                     String    @default("face-1")
  goal                       String    @default("")
  instructions               String    @default("")
  tone                       String    @default("Cercano y profesional")
  language                   String    @default("auto")
  status                     String    @default("active")
  model                      String?
  maxTokens                  Int       @default(512)
  memoryWindow               Int       @default(20)
  channels                   String[]  @default([])
  isDefault                  Boolean   @default(false)
  handoffKeywords            String[]  @default([])
  handoffAfterTurns          Int       @default(0)
  handoffOnUnknown           Boolean   @default(true)
  handoffMessage             String    @default("Te comunico con una persona del equipo, en un momento te responde.")
  autopilot                  Boolean   @default(false)
  autopilotChannels          String[]  @default([])
  autopilotAccounts          String[]  @default([])
  autopilotSkipTags          String[]  @default([])
  reengageAfterHours         Int       @default(0)
  copilotChannels            String[]  @default([])
  copilotSuggest             String    @default("auto")
  copilotTakeover            Boolean   @default(true)
  copilotTakeoverMinutes     Int       @default(10)
  copilotWarnMinutes         Int       @default(2)
  commentChannels            String[]  @default([])
  commentCopilotChannels     String[]  @default([])
  commentAccounts            String[]  @default([])
  commentReplyMode           Json?
  commentPublicTemplate      String?
  commentScope               String    @default("intent")
  commentAlwaysKeywords      String[]  @default([])
  commentNeverKeywords       String[]  @default([])
  commentIgnoreTagOnly       Boolean   @default(true)
  commentSensitiveAction     String    @default("private_and_handoff")
  commentHideOffensive       Boolean   @default(false)
  commentHideSpam            Boolean   @default(false)
  commentMaxPerPostPerHour   Int       @default(20)
  commentMaxPerAccountPerDay Int       @default(200)
  tools                      String[]  @default([])
  crmModules                 String[]  @default([])
  webhookUrl                 String?
  goalDoneAction             String    @default("none")
  goalDoneTag                String?
  hoursEnabled               Boolean   @default(false)
  hoursTimezone              String?
  hoursDays                  Int[]     @default([1, 2, 3, 4, 5])
  hoursStart                 String    @default("08:00")
  hoursEnd                   String    @default("18:00")
  outsideHours               String    @default("notice")
  outsideHoursMessage        String?
  ignoreSpam                 Boolean   @default(true)
  signatureMode              String    @default("off")
  signatureText              String?
  conversations              Int       @default(0)
  handoffs                   Int       @default(0)
  createdByEmail             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

/// Immutable log of conversation facts (ai_started, ai_handoff, ai_done, ai_spam, assigned, status).
model ConversationEvent {
  id             String       @id @default(cuid())
  conversationId String
  type           String
  actorType      String
  actorId        String?
  actorName      String?
  detail         String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ConversationTask {
  id             String       @id @default(cuid())
  conversationId String
  workspaceId    String
  title          String
  dueAt          DateTime?
  source         String       @default("user")
  agentName      String?
  doneAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([workspaceId, doneAt])
}

model AiKnowledgeDoc {
  id             String             @id @default(cuid())
  workspaceId    String
  agentIds       String[]           @default([])
  title          String
  kind           String
  sourceUrl      String?
  content        String             @default("")
  status         String             @default("pending")
  error          String?
  chunkCount     Int                @default(0)
  embeddingModel String?
  indexedAt      DateTime?
  createdByEmail String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  chunks         AiKnowledgeChunk[]

  @@index([workspaceId, status])
}

model AiKnowledgeChunk {
  id           String                 @id @default(cuid())
  docId        String
  workspaceId  String
  idx          Int
  text         String
  tokens       Int
  embeddingDim Int?
  embedding    Unsupported("vector")?
  createdAt    DateTime               @default(now())
  doc          AiKnowledgeDoc         @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([workspaceId, embeddingDim])
  @@index([docId])
}

model AiKnowledgeGap {
  id             String    @id @default(cuid())
  workspaceId    String
  agentId        String?
  conversationId String?
  question       String
  status         String    @default("open")
  answerDocId    String?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  @@index([workspaceId, status])
}

/// Copilot: reply suggested to the person handling a conversation. Status measures usefulness.
model AiSuggestion {
  id             String       @id @default(cuid())
  conversationId String
  agentId        String
  channel        String
  messageId      String?
  text           String
  privateText    String?
  context        String?
  trigger        String       @default("auto")
  status         String       @default("pending")
  model          String?
  costUsd        Float        @default(0)
  resolvedById   String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([agentId, status])
}

// ─── Marketing: campaigns, posts, publications per channel, metrics, blog ─────

enum MarketingChannel {
  WEB
  FACEBOOK
  INSTAGRAM
}

model MarketingCampaign {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  objective   String          @default("reach")
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  budget      Float?
  status      String          @default("draft")
  color       String          @default("#7C3AED")
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts       MarketingPost[]
  agent       MarketingAgent?

  @@index([workspaceId, status])
}

model MarketingPost {
  id           String                 @id @default(cuid())
  workspaceId  String
  campaignId   String?
  title        String
  brief        String?
  status       String                 @default("draft")
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  /// human | agent
  origin            String                 @default("human")
  agentId           String?
  ideaId            String?
  pillar            String?
  /// Supervised mode: goes out unless someone cancels or edits it before this
  optOutDeadline    DateTime?
  agentNoticeSentAt DateTime?
  rejectedReason    String?
  /// Variables the agent learns from: pillar, format, channel, slot, length, hashtags, image source, service, CTA
  features          Json?
  /// Agent's own notes: confidence, risks, hypothesis, why this time, guardrail issues
  agentMeta         Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     MarketingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agent        MarketingAgent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  variants     MarketingPostVariant[]
  media        MarketingMedia[]
  publications MarketingPublication[]

  @@index([workspaceId, status])
  @@index([campaignId])
  @@index([scheduledAt])
  @@index([agentId, status])
}

model MarketingPostVariant {
  id             String           @id @default(cuid())
  postId         String
  channel        MarketingChannel
  body           String           @default("")
  format         String?
  linkUrl        String?
  mediaIds       String[]         @default([])
  slug           String?          @unique
  seoTitle       String?
  seoDescription String?
  excerpt        String?
  coverUrl       String?
  category       String?
  tags           String[]         @default([])
  canonicalUrl   String?
  noindex        Boolean          @default(false)
  webPublishedAt DateTime?
  aiGenerated    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  post           MarketingPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageViews      WebPageView[]

  @@unique([postId, channel])
  @@index([channel, webPublishedAt])
}

model MarketingMedia {
  id          String        @id @default(cuid())
  postId      String
  url         String
  publicId    String?
  kind        String
  mime        String?
  bytes       Int?
  width       Int?
  height      Int?
  durationSec Float?
  alt         String?
  position    Int           @default(0)
  source      String        @default("upload")
  credit      String?
  creditUrl   String?
  originalUrl String?
  branded     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  post        MarketingPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model MarketingPublication {
  id             String                    @id @default(cuid())
  postId         String
  variantId      String
  channel        MarketingChannel
  connectionId   String?
  status         String                    @default("scheduled")
  scheduledAt    DateTime
  claimedAt      DateTime?
  claimToken     String?
  attempts       Int                       @default(0)
  lastError      String?
  idempotencyKey String                    @unique
  externalId     String?
  permalink      String?
  containerId    String?
  publishedAt    DateTime?
  metricsAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  post           MarketingPost             @relation(fields: [postId], references: [id], onDelete: Cascade)
  connection     ChannelConnection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  snapshots      MarketingMetricSnapshot[]

  @@index([status, scheduledAt])
  @@index([postId])
  @@index([externalId])
}

model MarketingMetricSnapshot {
  id            String               @id @default(cuid())
  publicationId String
  capturedAt    DateTime             @default(now())
  reach         Int                  @default(0)
  impressions   Int                  @default(0)
  likes         Int                  @default(0)
  comments      Int                  @default(0)
  shares        Int                  @default(0)
  saves         Int                  @default(0)
  clicks        Int                  @default(0)
  videoViews    Int                  @default(0)
  raw           Json?
  publication   MarketingPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, capturedAt])
}

model WebRedirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

model WebPageView {
  id        String               @id @default(cuid())
  variantId String
  day       String
  views     Int                  @default(0)
  variant   MarketingPostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, day])
}

/// Platform-wide image sources: Pexels key and the AI image provider (keys encrypted in one blob)
model MarketingImageSettings {
  id                  String   @id @default("platform")
  keysEncrypted       String?
  provider            String   @default("none")
  models              Json?
  cloudflareAccountId String?
  costPerImageUsd     Float    @default(0.04)
  updatedByEmail      String?
  updatedAt           DateTime @updatedAt
}

/// Brand kit of a workspace: the logo applied on post images and how
model MarketingBrandKit {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  logoUrl      String?
  logoPublicId String?
  logoPosition String    @default("south_east")
  logoScale    Float     @default(0.18)
  logoOpacity  Int       @default(90)
  logoMargin   Int       @default(24)
  autoApply    Boolean   @default(true)
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Marketing agent: strategist that plans, writes, schedules and learns for one campaign ─────

/// The agent's mind for one campaign: onboarding config, approved strategy, autonomy and limits
model MarketingAgent {
  id                    String                   @id @default(cuid())
  workspaceId           String
  campaignId            String                   @unique
  /// draft | active | paused | finished
  status                String                   @default("draft")
  /// copilot | supervised | autopilot
  mode                  String                   @default("copilot")
  /// Optional stricter mode per channel: { "WEB": "copilot" }
  modeByChannel         Json?
  /// Onboarding answers (validated by lib/marketing/agent-input.ts)
  config                Json
  strategy              Json?
  strategyProposedAt    DateTime?
  strategyApprovedAt    DateTime?
  strategyApprovedById  String?
  trialPostsRemaining   Int                      @default(5)
  optOutHours           Int                      @default(24)
  monthlyBudgetUsd      Float                    @default(10)
  confidenceThreshold   Float                    @default(0.7)
  exploreRatio          Float                    @default(0.3)
  horizonDays           Int                      @default(14)
  /// Who confirmed supervised/autopilot and when (audit)
  autonomyConfirmedAt   DateTime?
  autonomyConfirmedById String?
  /// Set while the agent is forced to copilot (budget, broken token); null when it runs in its mode
  degradedReason        String?
  budgetWarnedPeriod    String?
  lastPlannedAt         DateTime?
  lastLearnedAt         DateTime?
  lastRunAt             DateTime?
  /// Cron lock: one run per agent at a time
  lockedUntil           DateTime?
  createdById           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  workspace             Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign              MarketingCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  posts                 MarketingPost[]
  ideas                 MarketingIdea[]
  runs                  MarketingAgentRun[]
  learnings             MarketingAgentLearning[]
  notices               MarketingAgentNotice[]

  @@index([status])
  @@index([workspaceId])
}

/// Backlog of the agent: what to publish, why, and when
model MarketingIdea {
  id             String         @id @default(cuid())
  agentId        String
  pillar         String
  service        String?
  angle          String
  hypothesis     String?
  channels       String[]       @default([])
  /// Format per channel: { "INSTAGRAM": "feed", "WEB": "guía" }
  formats        Json?
  targetDate     DateTime
  /// morning | midday | evening
  slotHint       String?
  rationale      String?
  /// proposed | accepted | rejected | drafted | discarded
  status         String         @default("proposed")
  rejectedReason String?
  postId         String?        @unique
  score          Float          @default(0)
  explore        Boolean        @default(false)
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  agent          MarketingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([agentId, targetDate])
}

/// One execution of the agent (strategy, plan, draft, schedule, learn, notice): what it did, why and at what cost
model MarketingAgentRun {
  id         String         @id @default(cuid())
  agentId    String
  /// strategy | plan | draft | schedule | learn | notice
  type       String
  /// running | ok | skipped | error
  status     String         @default("running")
  summary    String?
  input      Json?
  output     Json?
  costUsd    Float          @default(0)
  tokensIn   Int            @default(0)
  tokensOut  Int            @default(0)
  model      String?
  error      String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  agent      MarketingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startedAt])
}

/// Weekly retrospective: results by dimension, findings and the changes it recommends
model MarketingAgentLearning {
  id                 String         @id @default(cuid())
  agentId            String
  periodStart        DateTime
  periodEnd          DateTime
  sampleSize         Int            @default(0)
  metricsByDimension Json
  insights           String
  recommendations    Json
  applied            Boolean        @default(false)
  appliedAt          DateTime?
  appliedById        String?
  createdAt          DateTime       @default(now())
  agent              MarketingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

/// What the agent tells people (in the app and by email): kept apart from customer/partner notifications
model MarketingAgentNotice {
  id           String         @id @default(cuid())
  agentId      String
  workspaceId  String
  postId       String?
  /// approval_needed | opt_out_window | published | failed | budget | learning | ideas | degraded
  type         String
  title        String
  body         String?
  url          String?
  /// Same notice once: e.g. "optout:<postId>", "budget80:<period>"
  dedupeKey    String?        @unique
  channelsSent String[]       @default([])
  readAt       DateTime?
  actionedAt   DateTime?
  createdAt    DateTime       @default(now())
  agent        MarketingAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt])
  @@index([agentId, createdAt])
}

// ─── Analytics and system health ─────────────────────────────────────────────

/// Every search on the site, visitors included, for analytics. SearchHistory stays the person's own recent searches.
model SearchEvent {
  id          String   @id @default(cuid())
  query       String
  /// Lowercase, no accents, single spaces: groups "Plomero" and "plomero "
  normalized  String
  resultCount Int
  userId      String?
  /// Anonymous visitor id (first-party cookie), to count unique searchers without an account
  visitorId   String?
  role        String?
  city        String?
  source      String   @default("servicios")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([normalized, createdAt])
}

/// One execution of a scheduled job: when it ran, how long, how it ended
model CronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  /// running | ok | error
  status     String    @default("running")
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@index([startedAt])
}

/// Application errors grouped by fingerprint (server logger and browser), with count and last occurrence
model AppErrorGroup {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  /// server | client
  source      String
  context     String?
  message     String
  route       String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  sample      Json?
  resolvedAt  DateTime?

  @@index([lastSeenAt])
}

/// Platform-wide analytics connections (Google Analytics 4 Data API; the service account is stored encrypted)
model AnalyticsSettings {
  id                      String   @id @default("platform")
  ga4PropertyId           String?
  ga4CredentialsEncrypted String?
  updatedByEmail          String?
  updatedAt               DateTime @updatedAt
}

