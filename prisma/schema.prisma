generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                                String                      @id @default(cuid())
  email                             String                      @unique
  name                              String
  password                          String
  phone                             String?
  image                             String?
  role                              UserRole                    @default(CLIENT)
  isActive                          Boolean                     @default(true)
  isSuperAdmin                      Boolean                     @default(false)
  excludedFromMarketing             Boolean                     @default(false)
  excludedFromMarketingAt           DateTime?
  excludedFromMarketingBy           String?
  pushSubscription                  String?
  notificationsPushEnabled          Boolean                     @default(true)
  notificationsEmailEnabled         Boolean                     @default(true)
  notificationsWhatsappEnabled      Boolean                     @default(true)
  notificationsSmsEnabled           Boolean                     @default(true)
  clientRating                      Float                       @default(0)
  clientTotalReviews                Int                         @default(0)
  completedServicesCount            Int                         @default(0)
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime                    @updatedAt
  /// First visit that brought the person: utm_*, referrer, landing page (first touch)
  acquisition                       Json?
  mercadopagoCustomerId             String?                     @unique
  addresses                         Address[]
  bookings                          Booking[]
  notifications                     Notification[]
  messagingCampaigns                MessagingCampaign[]         @relation("MessagingCampaignCreator")
  messagingDeliveries               MessagingDelivery[]
  notificationDispatches            NotificationDispatchLog[]
  messagingOptOuts                  MessagingOptOut[]
  automationExecutions              AutomationExecution[]
  partnerProfile                    PartnerProfile?
  payments                          Payment[]
  paymentMethods                    PaymentMethod[]
  serviceRequests                   ServiceRequest[]
  clientChats                       Chat[]                      @relation("ClientChats")
  favoritePartners                  FavoritePartner[]
  favoriteServices                  FavoriteService[]
  searchHistory                     SearchHistory[]
  supportCases                      AdminSupportCase[]
  fraudSignals                      FraudSignal[]
  paymentIncidents                  PaymentIncident[]
  refundCases                       RefundCase[]
  taxDocuments                      TaxDocument[]
  complianceEvaluations             ComplianceEvaluation[]
  pwaTelemetryEvents                PwaTelemetryEvent[]
  pwaAdoptionProfile                PwaAdoptionProfile?
  notificationEmailTemplatesUpdated NotificationEmailTemplate[] @relation("NotificationEmailTemplateUpdatedBy")
  magicTokens                       MagicToken[]
  conversations                     Conversation[]
  assignedConversations             Conversation[]              @relation("AgentConversations")
  sentMessages                      ConversationMessage[]       @relation("AgentMessages")
  workspaceMemberships              WorkspaceMember[]
  inboxContacts                     Contact[]
  createdWorkspaces                 Workspace[]                 @relation("WorkspaceCreator")
}

model PartnerProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  bio                    String?
  rating                 Float                  @default(0)
  totalReviews           Int                    @default(0)
  completedServicesCount Int                    @default(0)
  isActive               Boolean                @default(true)
  verified               Boolean                @default(false)
  city                   City                   @default(MEDELLIN)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  slug                   String?                @unique
  isPublicProfile        Boolean                @default(true)
  profileHeadline        String?
  isAvailable            Boolean                @default(true)
  isCompany              Boolean                @default(false)
  companyName            String?
  companyNit             String?
  workPhotos             PartnerWorkPhoto[]
  availability           Availability[]
  bookings               Booking[]
  achievements           PartnerAchievement[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               PartnerService[]
  payouts                Payout[]
  proposals              Proposal[]
  documents              VerificationDocument[]
  partnerChats           Chat[]                 @relation("PartnerChats")
  directRequests         ServiceRequest[]       @relation("DirectRequests")
  favoritedBy            FavoritePartner[]
  fraudSignals           FraudSignal[]
  bankAccounts           PartnerBankAccount[]
  paymentIncidents       PaymentIncident[]
  refundCases            RefundCase[]
  complianceEvaluations  ComplianceEvaluation[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String
  description String?
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  icon             String
  categoryId       String
  basePrice        Float
  duration         Int
  popular          Boolean           @default(false)
  showPartnerCount Boolean           @default(true)
  showAvgRating    Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookings         Booking[]
  partners         PartnerService[]
  category         Category          @relation(fields: [categoryId], references: [id])
  serviceRequests  ServiceRequest[]
  advertisements   Advertisement[]
  favoritedBy      FavoriteService[]
}

model PartnerService {
  id           String                 @id @default(cuid())
  partnerId    String
  serviceId    String
  price        Float
  city         City                   @default(MEDELLIN)
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  availability Availability[]
  documents    VerificationDocument[]
  partner      PartnerProfile         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service      Service                @relation(fields: [serviceId], references: [id])

  @@unique([partnerId, serviceId])
}

model Availability {
  id               String          @id @default(cuid())
  partnerId        String
  partnerServiceId String?
  dayOfWeek        Int
  startTime        String
  endTime          String
  active           Boolean         @default(true)
  partner          PartnerProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerService   PartnerService? @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String             @id @default(cuid())
  userId                String
  serviceId             String
  partnerId             String?
  proposalId            String?
  scheduledDate         DateTime
  scheduledTime         String
  address               String
  notes                 String?
  city                  City               @default(MEDELLIN)
  status                BookingStatus      @default(PENDING)
  totalPrice            Float
  clientCommissionRate  Float?
  partnerCommissionRate Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  partner               PartnerProfile?    @relation(fields: [partnerId], references: [id])
  proposal              Proposal?          @relation(fields: [proposalId], references: [id])
  service               Service            @relation(fields: [serviceId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  payment               Payment?
  review                Review?
  supportCases          AdminSupportCase[]
  fraudSignals          FraudSignal[]
  paymentIncidents      PaymentIncident[]
  refundCases           RefundCase[]
}

model Review {
  id                     String    @id @default(cuid())
  bookingId              String    @unique
  clientToPartnerRating  Int?
  clientToPartnerComment String?
  clientReviewedAt       DateTime?
  partnerToClientRating  Int?
  partnerToClientComment String?
  partnerReviewedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  userId        String
  serviceId     String
  partnerId     String?
  address       String
  notes         String?
  budget        Float?
  city          City                 @default(MEDELLIN)
  preferredDate DateTime?
  preferredTime String?
  isUrgent      Boolean              @default(false)
  status        ServiceRequestStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  proposals     Proposal[]
  photos        RequestPhoto[]
  service       Service              @relation(fields: [serviceId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  partner       PartnerProfile?      @relation("DirectRequests", fields: [partnerId], references: [id])
  chats         Chat[]
  supportCases  AdminSupportCase[]
}

model Proposal {
  id               String         @id @default(cuid())
  serviceRequestId String
  partnerId        String
  price            Float
  notes            String?
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookings         Booking[]
  partner          PartnerProfile @relation(fields: [partnerId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  chat             Chat?

  @@unique([serviceRequestId, partnerId])
}

model Notification {
  id         String                    @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  data       String?
  read       Boolean                   @default(false)
  createdAt  DateTime                  @default(now())
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatches NotificationDispatchLog[]

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationAutomationConfig {
  id              String                       @id @default(cuid())
  target          NotificationAutomationTarget @unique
  pushEnabled     Boolean                      @default(true)
  emailEnabled    Boolean                      @default(false)
  whatsappEnabled Boolean                      @default(false)
  smsEnabled      Boolean                      @default(false)
  updatedByEmail  String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model NotificationDispatchLog {
  id                String                     @id @default(cuid())
  notificationId    String?
  userId            String
  userRole          UserRole
  notificationType  NotificationType
  channel           MessagingChannel
  destination       String?
  status            NotificationDispatchStatus @default(PENDING)
  provider          String
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  metadata          String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime                   @default(now())
  notification      Notification?              @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([channel, status, createdAt])
  @@index([notificationType, createdAt])
  @@index([providerMessageId])
}

model NotificationEmailTemplate {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  notificationType NotificationType
  channel          MessagingChannel
  role             UserRole?
  subjectTemplate  String?
  bodyTemplate     String
  bodyHtmlTemplate String?
  bodyTextTemplate String?
  isActive         Boolean          @default(true)
  updatedByEmail   String?
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  updatedBy        User?            @relation("NotificationEmailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([notificationType, channel, role])
  @@index([notificationType, channel, isActive])
  @@index([role, isActive])
}

model MessagingTemplate {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  channel   MessagingChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  metadata  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  campaigns MessagingCampaign[]

  @@index([channel, isActive])
}

model MessagingCampaign {
  id              String                  @id @default(cuid())
  name            String
  channel         MessagingChannel
  status          MessagingCampaignStatus @default(DRAFT)
  templateId      String?
  targetRole      UserRole?
  targetCity      City?
  customSubject   String?
  customBody      String
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int                     @default(0)
  totalSent       Int                     @default(0)
  totalFailed     Int                     @default(0)
  createdById     String?
  metadata        String?
  abTestEnabled   Boolean                 @default(false)
  abTestConfig    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  template        MessagingTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("MessagingCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries      MessagingDelivery[]

  @@index([status, channel, createdAt])
  @@index([targetRole, targetCity])
}

model MessagingDelivery {
  id                String                  @id @default(cuid())
  campaignId        String
  userId            String
  channel           MessagingChannel
  destination       String
  status            MessagingDeliveryStatus @default(PENDING)
  provider          String
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  metadata          String?
  abVariant         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  campaign          MessagingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([userId, channel, createdAt])
}

model MessagingOptOut {
  id          String           @id @default(cuid())
  userId      String?
  channel     MessagingChannel
  destination String
  reason      String?
  source      String           @default("user")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([channel, destination])
  @@index([userId, channel, isActive])
}

model MessagingProviderConfig {
  id              String            @id @default(cuid())
  provider        MessagingProvider @unique
  isActive        Boolean           @default(true)
  configEncrypted String
  updatedByEmail  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AutomationRule {
  id           String                @id @default(cuid())
  name         String
  description  String?
  trigger      AutomationTrigger
  targetRole   UserRole?
  delayHours   Int                   @default(0)
  channels     String // JSON array of MessagingChannel
  waTemplateFn String? // function name in whatsapp-templates.ts
  customBody   String? // for SMS / Email body (supports {{name}} vars)
  subject      String? // for Email subject
  isActive     Boolean               @default(true)
  metadata     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  executions   AutomationExecution[]

  @@index([trigger, isActive])
}

model AutomationExecution {
  id          String           @id @default(cuid())
  ruleId      String
  userId      String
  channel     MessagingChannel
  status      String           @default("PENDING")
  contextId   String? // booking ID, conversation ID, etc. for repeatable triggers
  scheduledAt DateTime
  executedAt  DateTime?
  error       String?
  createdAt   DateTime         @default(now())
  rule        AutomationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId, channel, contextId])
  @@index([scheduledAt, status])
  @@index([userId, status])
}

enum AutomationTrigger {
  // Registration
  PARTNER_REGISTERED
  CLIENT_REGISTERED
  // Reminders (scheduled at sign-up)
  PARTNER_DOCS_REMINDER
  PARTNER_REFERRAL_REMINDER
  CLIENT_FIRST_BOOKING_NUDGE
  CLIENT_REFERRAL_REMINDER
  // Documents
  PARTNER_DOCS_APPROVED
  PARTNER_DOCS_REJECTED
  PARTNER_ACTIVATED
  // Bookings
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  // Reviews
  REVIEW_RECEIVED
  // Messaging / chat
  INBOUND_MESSAGE
}

model PwaTelemetryEvent {
  id        String    @id @default(cuid())
  userId    String?
  sessionId String?
  eventName String
  role      UserRole?
  city      City?
  platform  String?
  browser   String?
  source    String?
  metadata  String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([role, createdAt])
  @@index([city, createdAt])
}

model PwaAdoptionProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  abVariant            String    @default("A")
  promptWindowStartAt  DateTime?
  promptAttemptsWindow Int       @default(0)
  consecutiveDismisses Int       @default(0)
  lastPromptAt         DateTime?
  nextEligibleAt       DateTime?
  deprioritizedUntil   DateTime?
  installedAt          DateTime?
  pushEnabledAt        DateTime?
  lastContext          String?
  lastContextAt        DateTime?
  lastStageShown       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextEligibleAt, deprioritizedUntil])
  @@index([lastContextAt])
  @@index([abVariant])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         City
  postalCode   String?
  instructions String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isPrimary])
}

model RequestPhoto {
  id               String         @id @default(cuid())
  serviceRequestId String
  url              String
  publicId         String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model VerificationDocument {
  id               String          @id @default(cuid())
  partnerId        String
  type             DocumentType
  documentUrl      String
  publicId         String?
  status           DocumentStatus  @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  partnerServiceId String?
  partner          PartnerProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerService   PartnerService? @relation(fields: [partnerServiceId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([status])
}

model Achievement {
  id          String               @id @default(cuid())
  type        AchievementType      @unique
  name        String
  description String
  icon        String
  level       Int                  @default(1)
  createdAt   DateTime             @default(now())
  partners    PartnerAchievement[]
}

model PartnerAchievement {
  id            String         @id @default(cuid())
  partnerId     String
  achievementId String
  unlockedAt    DateTime       @default(now())
  achievement   Achievement    @relation(fields: [achievementId], references: [id])
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, achievementId])
  @@index([partnerId])
}

model PartnerWorkPhoto {
  id        String         @id @default(cuid())
  partnerId String
  url       String
  publicId  String?
  caption   String?
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PaymentMethod {
  id                String    @id @default(cuid())
  userId            String
  mercadopagoCardId String?   @unique
  cardToken         String?
  lastFourDigits    String
  cardBrand         String
  cardholderName    String
  expirationMonth   Int
  expirationYear    Int
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payments          Payment[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mercadopagoCardId])
}

model Payment {
  id                     String                    @id @default(cuid())
  bookingId              String                    @unique
  userId                 String
  paymentMethodId        String?
  mercadopagoId          String?                   @unique
  preferenceId           String?
  amount                 Float
  serviceAmount          Float
  clientCommission       Float
  clientCommissionRate   Float
  totalAmount            Float
  status                 PaymentStatus             @default(PENDING)
  paymentMethodType      String?
  paymentType            String?
  transactionAmount      Float?
  netReceivedAmount      Float?
  mercadopagoFee         Float?
  metadata               String?
  paidAt                 DateTime?
  confirmationStatus     PaymentConfirmationStatus @default(NONE)
  clientReportedMethod   OfflinePaymentMethod?
  clientReportedAt       DateTime?
  clientReportNote       String?
  partnerConfirmedMethod OfflinePaymentMethod?
  partnerConfirmedAt     DateTime?
  partnerRejectedAt      DateTime?
  rejectionReason        String?
  lastReminderAt         DateTime?
  reminderCount          Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  booking                Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod          PaymentMethod?            @relation(fields: [paymentMethodId], references: [id])
  user                   User                      @relation(fields: [userId], references: [id])
  payout                 Payout?
  incidents              PaymentIncident[]
  refundCases            RefundCase[]
  taxDocuments           TaxDocument[]

  @@index([userId])
  @@index([status])
  @@index([mercadopagoId])
  @@index([paymentMethodId])
}

model Payout {
  id                    String              @id @default(cuid())
  paymentId             String              @unique
  partnerId             String
  bankAccountId         String?
  amount                Float
  partnerCommission     Float
  partnerCommissionRate Float
  netAmount             Float
  status                PayoutStatus        @default(PENDING)
  externalTransferId    String?
  processorStatus       String?
  processorMessage      String?
  processedBy           String?
  processedAt           DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  partner               PartnerProfile      @relation(fields: [partnerId], references: [id])
  payment               Payment             @relation(fields: [paymentId], references: [id])
  bankAccount           PartnerBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([status])
  @@index([paymentId])
  @@index([bankAccountId])
  @@index([externalTransferId])
}

model PlatformConfig {
  id                    String   @id @default(cuid())
  key                   String   @unique
  commissionRate        Float
  clientCommissionRate  Float    @default(5.0)
  partnerCommissionRate Float    @default(10.0)
  minServicePrice       Float
  maxServicePrice       Float
  commissionEnabled     Boolean  @default(false)
  cashEnabled           Boolean  @default(true)
  transferEnabled       Boolean  @default(true)
  mercadoPagoEnabled    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([key])
}

enum UserRole {
  CLIENT
  PARTNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CityConfig {
  id              String          @id @default(cuid())
  name            String          @unique
  slug            String          @unique
  status          CityStatus      @default(ACTIVE)
  order           Int             @default(0)
  latitude        Float?
  longitude       Float?
  isLaunched      Boolean         @default(false)
  launchDate      DateTime?
  partnerRegistry Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  advertisements  Advertisement[]
}

enum CityStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum City {
  MEDELLIN
  BOGOTA
  CALI
  BARRANQUILLA
}

enum NotificationType {
  NEW_SERVICE_REQUEST
  NEW_PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  ACHIEVEMENT_UNLOCKED
  NEW_MESSAGE
  PAYMENT_REPORTED_BY_CLIENT
  PAYMENT_CONFIRMED_BY_PARTNER
  PAYMENT_REJECTED_BY_PARTNER
  RATING_RECEIVED
  RATING_REMINDER
  REQUEST_EXPIRING_SOON
  BOOKING_REMINDER_24H
  BOOKING_STARTING_SOON
  PAYMENT_PENDING_REMINDER
}

enum NotificationAutomationTarget {
  GLOBAL
  CLIENT
  PARTNER
  ADMIN
}

enum NotificationDispatchStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
