generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  name                  String
  password              String
  phone                 String?
  image                 String?
  role                  UserRole         @default(CLIENT)
  isActive              Boolean          @default(true)
  pushSubscription      String?
  clientRating          Float            @default(0)
  clientTotalReviews    Int              @default(0)
  completedServicesCount Int             @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  mercadopagoCustomerId String?          @unique
  addresses             Address[]
  bookings              Booking[]
  notifications         Notification[]
  partnerProfile        PartnerProfile?
  payments              Payment[]
  paymentMethods        PaymentMethod[]
  serviceRequests       ServiceRequest[]
  clientChats           Chat[]           @relation("ClientChats")
  favoritePartners      FavoritePartner[]
  searchHistory         SearchHistory[]
}

model PartnerProfile {
  id           String                 @id @default(cuid())
  userId       String                 @unique
  bio          String?
  rating       Float                  @default(0)
  totalReviews Int                    @default(0)
  completedServicesCount Int          @default(0)
  isActive     Boolean                @default(true)
  verified     Boolean                @default(false)
  city         City                   @default(MEDELLIN)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  availability Availability[]
  bookings     Booking[]
  achievements PartnerAchievement[]
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     PartnerService[]
  payouts      Payout[]
  proposals    Proposal[]
  documents    VerificationDocument[]
  partnerChats Chat[]                 @relation("PartnerChats")
  directRequests ServiceRequest[]     @relation("DirectRequests")
  favoritedBy  FavoritePartner[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String
  description String?
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String
  icon            String
  categoryId      String
  basePrice       Float
  duration        Int
  popular         Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  partners        PartnerService[]
  category        Category         @relation(fields: [categoryId], references: [id])
  serviceRequests ServiceRequest[]
  advertisements  Advertisement[]
}

model PartnerService {
  id           String         @id @default(cuid())
  partnerId    String
  serviceId    String
  price        Float
  city         City           @default(MEDELLIN)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  availability Availability[]
  partner      PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id])

  @@unique([partnerId, serviceId])
}

model Availability {
  id               String          @id @default(cuid())
  partnerId        String
  partnerServiceId String?
  dayOfWeek        Int
  startTime        String
  endTime          String
  active           Boolean         @default(true)
  partner          PartnerProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerService   PartnerService? @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String          @id @default(cuid())
  userId                String
  serviceId             String
  partnerId             String?
  proposalId            String?
  scheduledDate         DateTime
  scheduledTime         String
  address               String
  notes                 String?
  city                  City            @default(MEDELLIN)
  status                BookingStatus   @default(PENDING)
  totalPrice            Float
  clientCommissionRate  Float?
  partnerCommissionRate Float?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  partner               PartnerProfile? @relation(fields: [partnerId], references: [id])
  proposal              Proposal?       @relation(fields: [proposalId], references: [id])
  service               Service         @relation(fields: [serviceId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])
  payment               Payment?
  review                Review?
}

model Review {
  id                     String    @id @default(cuid())
  bookingId              String    @unique
  clientToPartnerRating  Int?
  clientToPartnerComment String?
  clientReviewedAt       DateTime?
  partnerToClientRating  Int?
  partnerToClientComment String?
  partnerReviewedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  userId        String
  serviceId     String
  partnerId     String?
  address       String
  notes         String?
  city          City                 @default(MEDELLIN)
  preferredDate DateTime?
  preferredTime String?
  isUrgent      Boolean              @default(false)
  status        ServiceRequestStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  proposals     Proposal[]
  photos        RequestPhoto[]
  service       Service              @relation(fields: [serviceId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  partner       PartnerProfile?      @relation("DirectRequests", fields: [partnerId], references: [id])
  chats         Chat[]
}

model Proposal {
  id               String         @id @default(cuid())
  serviceRequestId String
  partnerId        String
  price            Float
  notes            String?
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookings         Booking[]
  partner          PartnerProfile @relation(fields: [partnerId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  chat             Chat?

  @@unique([serviceRequestId, partnerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         City
  postalCode   String?
  instructions String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isPrimary])
}

model RequestPhoto {
  id               String         @id @default(cuid())
  serviceRequestId String
  url              String
  publicId         String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model VerificationDocument {
  id              String         @id @default(cuid())
  partnerId       String
  type            DocumentType
  documentUrl     String
  publicId        String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  partner         PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([status])
}

model Achievement {
  id          String               @id @default(cuid())
  type        AchievementType      @unique
  name        String
  description String
  icon        String
  level       Int                  @default(1)
  createdAt   DateTime             @default(now())
  partners    PartnerAchievement[]
}

model PartnerAchievement {
  id            String         @id @default(cuid())
  partnerId     String
  achievementId String
  unlockedAt    DateTime       @default(now())
  achievement   Achievement    @relation(fields: [achievementId], references: [id])
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, achievementId])
  @@index([partnerId])
}

model PaymentMethod {
  id                String    @id @default(cuid())
  userId            String
  mercadopagoCardId String?   @unique
  cardToken         String?
  lastFourDigits    String
  cardBrand         String
  cardholderName    String
  expirationMonth   Int
  expirationYear    Int
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payments          Payment[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mercadopagoCardId])
}

model Payment {
  id                   String         @id @default(cuid())
  bookingId            String         @unique
  userId               String
  paymentMethodId      String?
  mercadopagoId        String?        @unique
  preferenceId         String?
  amount               Float
  serviceAmount        Float
  clientCommission     Float
  clientCommissionRate Float
  totalAmount          Float
  status               PaymentStatus  @default(PENDING)
  paymentMethodType    String?
  paymentType          String?
  transactionAmount    Float?
  netReceivedAmount    Float?
  mercadopagoFee       Float?
  metadata             String?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  booking              Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  user                 User           @relation(fields: [userId], references: [id])
  payout               Payout?

  @@index([userId])
  @@index([status])
  @@index([mercadopagoId])
  @@index([paymentMethodId])
}

model Payout {
  id                    String         @id @default(cuid())
  paymentId             String         @unique
  partnerId             String
  amount                Float
  partnerCommission     Float
  partnerCommissionRate Float
  netAmount             Float
  status                PayoutStatus   @default(PENDING)
  processedBy           String?
  processedAt           DateTime?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  partner               PartnerProfile @relation(fields: [partnerId], references: [id])
  payment               Payment        @relation(fields: [paymentId], references: [id])

  @@index([partnerId])
  @@index([status])
  @@index([paymentId])
}

model PlatformConfig {
  id                    String   @id @default(cuid())
  key                   String   @unique
  commissionRate        Float
  clientCommissionRate  Float    @default(5.0)
  partnerCommissionRate Float    @default(10.0)
  minServicePrice       Float
  maxServicePrice       Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([key])
}

enum UserRole {
  CLIENT
  PARTNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CityConfig {
  id               String          @id @default(cuid())
  name             String          @unique
  slug             String          @unique
  status           CityStatus      @default(ACTIVE)
  order            Int             @default(0)
  latitude         Float?
  longitude        Float?
  lanzamiento      Boolean         @default(false)
  fechaLanzamiento DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  advertisements   Advertisement[]
}

enum CityStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum City {
  MEDELLIN
  BOGOTA
  CALI
  BARRANQUILLA
}

enum NotificationType {
  NEW_SERVICE_REQUEST
  NEW_PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  ACHIEVEMENT_UNLOCKED
  NEW_MESSAGE
}

enum DocumentType {
  CEDULA_CIUDADANIA
  CEDULA_EXTRANJERIA
  PASAPORTE
  PEP
  DIPLOMA_BACHILLERATO
  DIPLOMA_TECNICO
  DIPLOMA_TECNOLOGO
  DIPLOMA_PROFESIONAL
  DIPLOMA_POSGRADO
  CERTIFICADO_CURSO
  ANTECEDENTES
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AchievementType {
  IDENTITY_VERIFIED
  EDUCATION_VERIFIED
  BACKGROUND_CHECK_VERIFIED
  FIRST_SERVICE
  TEN_SERVICES
  FIFTY_SERVICES
  HUNDRED_SERVICES
  FIVE_STAR_RATING
  VERIFIED_PARTNER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Chat {
  id               String          @id @default(cuid())
  serviceRequestId String
  proposalId       String          @unique
  clientId         String
  partnerId        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  messages         ChatMessage[]
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  proposal         Proposal        @relation(fields: [proposalId], references: [id])
  client           User            @relation("ClientChats", fields: [clientId], references: [id])
  partner          PartnerProfile  @relation("PartnerChats", fields: [partnerId], references: [id])

  @@unique([serviceRequestId, clientId, partnerId])
  @@index([clientId])
  @@index([partnerId])
  @@index([serviceRequestId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
}

model PaymentConfig {
  id                        String              @id @default(cuid())
  environment               PaymentEnvironment  @default(TEST)
  testAccessToken           String?
  testPublicKey             String?
  testClientId              String?
  testClientSecret          String?
  productionAccessToken     String?
  productionPublicKey       String?
  productionClientId        String?
  productionClientSecret    String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model FavoritePartner {
  id        String         @id @default(cuid())
  userId    String
  partnerId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@index([userId])
  @@index([partnerId])
}

model Advertisement {
  id          String            @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  placement   AdPlacement
  serviceId   String?
  cityId      String
  active      Boolean           @default(true)
  startDate   DateTime          @default(now())
  endDate     DateTime?
  priority    Int               @default(0)
  impressions Int               @default(0)
  clicks      Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city        CityConfig        @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([placement, active, startDate, endDate])
  @@index([serviceId])
  @@index([cityId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum AdPlacement {
  HOME
  SERVICE
}

enum PaymentEnvironment {
  TEST
  PRODUCTION
}