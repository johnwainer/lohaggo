model Conversation {
  id                      String                @id @default(cuid())
  channel                 MessagingChannel
  contactPhone            String
  contactName             String?
  userId                  String?
  assignedToId            String?
  status                  ConversationStatus    @default(OPEN)
  tags                    String[]              @default([])
  lastMessageAt           DateTime?
  lastMessageBody         String?
  unreadCount             Int                   @default(0)
  workspaceId             String
  connectionId            String?
  threadOwner             String?
  aiHandled               Boolean               @default(false)
  aiAgentId               String?
  aiAgentName             String?
  aiTurns                 Int                   @default(0)
  aiSpam                  Boolean               @default(false)
  aiSummary               String?
  aiSummaryCount          Int                   @default(0)
  automationsPaused       Boolean               @default(false)
  priority                String                @default("normal")
  customFields            Json?
  reengagedAt             DateTime?
  aiHandoffAt             DateTime?
  isTest                  Boolean               @default(false)
  contactId               String?
  copilotSkipMessageId    String?
  copilotAlertedMessageId String?
  postId                  String?
  postPermalink           String?
  postCaption             String?
  postMediaUrl            String?
  rootCommentId           String?
  privateReplyUsedAt      DateTime?
  isAd                    Boolean               @default(false)
  commentKind             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  contact                 Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events                  ConversationEvent[]
  suggestions             AiSuggestion[]
  tasks                   ConversationTask[]
  user                    User?                 @relation(fields: [userId], references: [id])
  assignedTo              User?                 @relation("AgentConversations", fields: [assignedToId], references: [id])
  workspace               Workspace             @relation(fields: [workspaceId], references: [id])
  connection              ChannelConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  messages                ConversationMessage[]

  @@unique([channel, contactPhone])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([assignedToId])
  @@index([connectionId])
  @@index([workspaceId, lastMessageAt(sort: Desc)])
  @@index([aiHandled, lastMessageAt])
  @@index([contactId])
  @@index([postId])
}

/// One person across channels. WhatsApp (the phone) is the base identity; Meta ids hang from it.
model Contact {
  id            String            @id @default(cuid())
  workspaceId   String
  name          String?
  phone         String?
  email         String?
  notes         String?
  userId        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  identities    ContactIdentity[]
  conversations Conversation[]

  @@unique([workspaceId, phone])
  @@index([workspaceId, updatedAt])
  @@index([userId])
}

/// How a contact is addressed on a channel: E.164 phone for WhatsApp/SMS, PSID / IGSID for Meta.
model ContactIdentity {
  id         String           @id @default(cuid())
  contactId  String
  channel    MessagingChannel
  externalId String
  createdAt  DateTime         @default(now())
  contact    Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([contactId])
}

model Workspace {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  isDefault           Boolean               @default(false)
  createdById         String?
  timezone            String                @default("America/Bogota")
  aiMonthlyCostCapUsd Float?
  aiMonthlyCallCap    Int?
  aiCapWarnedPeriod   String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  createdBy           User?                 @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members             WorkspaceMember[]
  connections         ChannelConnection[]
  conversations       Conversation[]
  oauthSessions       ChannelOAuthSession[]
  aiAgents            AiAgent[]
  contacts            Contact[]
  marketingCampaigns  MarketingCampaign[]
  marketingPosts      MarketingPost[]
  marketingBrandKit   MarketingBrandKit?
  marketingAgents     MarketingAgent[]

  @@index([isDefault])
}

model WorkspaceMember {
  id             String        @id @default(cuid())
  workspaceId    String
  userId         String
  role           WorkspaceRole @default(MEMBER)
  permissions    String[]      @default([])
  invitedByEmail String?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model ChannelConnection {
  id                    String                  @id @default(cuid())
  workspaceId           String
  workspace             Workspace               @relation(fields: [workspaceId], references: [id])
  channel               MessagingChannel
  externalId            String
  name                  String
  status                ChannelConnectionStatus @default(ACTIVE)
  enabled               Boolean                 @default(true)
  credentialsEncrypted  String
  meta                  Json?
  capabilities          Json?
  commentSettings       Json?
  lastError             String?
  lastEventAt           DateTime?
  connectedByEmail      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  conversations         Conversation[]
  marketingPublications MarketingPublication[]

  @@unique([channel, externalId])
  @@index([enabled])
  @@index([workspaceId])
}

model WebhookEvent {
  id         String             @id @default(cuid())
  channel    MessagingChannel
  externalId String?
  status     WebhookEventStatus
  detail     String?
  payload    Json?
  createdAt  DateTime           @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([channel, externalId])
}

model ChannelOAuthSession {
