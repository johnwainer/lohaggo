  decidedById    String?
  decidedByEmail String?
  decidedAt      DateTime?
  decisionNote   String?
  executedAt     DateTime?
  revertedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model HaggoMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String?
  runId     String?
  actionIds String[] @default([])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HaggoDirective {
  id             String   @id @default(cuid())
  text           String
  rule           Json?
  active         Boolean  @default(true)
  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HaggoMemory {
  id        String   @id @default(cuid())
  kind      String
  key       String?
  content   String
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, updatedAt])
}
