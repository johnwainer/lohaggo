generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  password               String
  phone                  String?
  image                  String?
  role                   UserRole               @default(CLIENT)
  isActive               Boolean                @default(true)
  pushSubscription       String?
  notificationsPushEnabled Boolean              @default(true)
  notificationsEmailEnabled Boolean             @default(true)
  notificationsWhatsappEnabled Boolean          @default(true)
  notificationsSmsEnabled Boolean               @default(true)
  clientRating           Float                  @default(0)
  clientTotalReviews     Int                    @default(0)
  completedServicesCount Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  mercadopagoCustomerId  String?                @unique
  addresses              Address[]
  bookings               Booking[]
  notifications          Notification[]
  messagingCampaigns     MessagingCampaign[]    @relation("MessagingCampaignCreator")
  messagingDeliveries    MessagingDelivery[]
  notificationDispatches NotificationDispatchLog[]
  messagingOptOuts       MessagingOptOut[]
  partnerProfile         PartnerProfile?
  payments               Payment[]
  paymentMethods         PaymentMethod[]
  serviceRequests        ServiceRequest[]
  clientChats            Chat[]                 @relation("ClientChats")
  favoritePartners       FavoritePartner[]
  favoriteServices       FavoriteService[]
  searchHistory          SearchHistory[]
  supportCases           AdminSupportCase[]
  fraudSignals           FraudSignal[]
  paymentIncidents       PaymentIncident[]
  refundCases            RefundCase[]
  taxDocuments           TaxDocument[]
  complianceEvaluations  ComplianceEvaluation[]
  pwaTelemetryEvents     PwaTelemetryEvent[]
  pwaAdoptionProfile     PwaAdoptionProfile?
  notificationEmailTemplatesUpdated NotificationEmailTemplate[] @relation("NotificationEmailTemplateUpdatedBy")
}

model PartnerProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  bio                    String?
  rating                 Float                  @default(0)
  totalReviews           Int                    @default(0)
  completedServicesCount Int                    @default(0)
  isActive               Boolean                @default(true)
  verified               Boolean                @default(false)
  city                   City                   @default(MEDELLIN)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  availability           Availability[]
  bookings               Booking[]
  achievements           PartnerAchievement[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               PartnerService[]
  payouts                Payout[]
  proposals              Proposal[]
  documents              VerificationDocument[]
  partnerChats           Chat[]                 @relation("PartnerChats")
  directRequests         ServiceRequest[]       @relation("DirectRequests")
  favoritedBy            FavoritePartner[]
  fraudSignals           FraudSignal[]
  bankAccounts           PartnerBankAccount[]
  paymentIncidents       PaymentIncident[]
  refundCases            RefundCase[]
  complianceEvaluations  ComplianceEvaluation[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  icon        String
  description String?
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String
  icon            String
  categoryId      String
  basePrice       Float
  duration        Int
  popular         Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookings        Booking[]
  partners        PartnerService[]
  category        Category          @relation(fields: [categoryId], references: [id])
  serviceRequests ServiceRequest[]
  advertisements  Advertisement[]
  favoritedBy     FavoriteService[]
}

model PartnerService {
  id           String         @id @default(cuid())
  partnerId    String
  serviceId    String
  price        Float
  city         City           @default(MEDELLIN)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  availability Availability[]
  partner      PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id])

  @@unique([partnerId, serviceId])
}

model Availability {
  id               String          @id @default(cuid())
  partnerId        String
  partnerServiceId String?
  dayOfWeek        Int
  startTime        String
  endTime          String
  active           Boolean         @default(true)
  partner          PartnerProfile  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerService   PartnerService? @relation(fields: [partnerServiceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    String             @id @default(cuid())
  userId                String
  serviceId             String
  partnerId             String?
  proposalId            String?
  scheduledDate         DateTime
  scheduledTime         String
  address               String
  notes                 String?
  city                  City               @default(MEDELLIN)
  status                BookingStatus      @default(PENDING)
  totalPrice            Float
  clientCommissionRate  Float?
  partnerCommissionRate Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  partner               PartnerProfile?    @relation(fields: [partnerId], references: [id])
  proposal              Proposal?          @relation(fields: [proposalId], references: [id])
  service               Service            @relation(fields: [serviceId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  payment               Payment?
  review                Review?
  supportCases          AdminSupportCase[]
  fraudSignals          FraudSignal[]
  paymentIncidents      PaymentIncident[]
  refundCases           RefundCase[]
}

model Review {
  id                     String    @id @default(cuid())
  bookingId              String    @unique
  clientToPartnerRating  Int?
  clientToPartnerComment String?
  clientReviewedAt       DateTime?
  partnerToClientRating  Int?
  partnerToClientComment String?
  partnerReviewedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  userId        String
  serviceId     String
  partnerId     String?
  address       String
  notes         String?
  budget        Float?
  city          City                 @default(MEDELLIN)
  preferredDate DateTime?
  preferredTime String?
  isUrgent      Boolean              @default(false)
  status        ServiceRequestStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  proposals     Proposal[]
  photos        RequestPhoto[]
  service       Service              @relation(fields: [serviceId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  partner       PartnerProfile?      @relation("DirectRequests", fields: [partnerId], references: [id])
  chats         Chat[]
  supportCases  AdminSupportCase[]
}

model Proposal {
  id               String         @id @default(cuid())
  serviceRequestId String
  partnerId        String
  price            Float
  notes            String?
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  bookings         Booking[]
  partner          PartnerProfile @relation(fields: [partnerId], references: [id])
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  chat             Chat?

  @@unique([serviceRequestId, partnerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatches NotificationDispatchLog[]

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationAutomationConfig {
  id            String                       @id @default(cuid())
  target        NotificationAutomationTarget @unique
  pushEnabled   Boolean                      @default(true)
  emailEnabled  Boolean                      @default(false)
  whatsappEnabled Boolean                    @default(false)
  smsEnabled    Boolean                      @default(false)
  updatedByEmail String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
}

model NotificationDispatchLog {
  id                String                   @id @default(cuid())
  notificationId    String?
  userId            String
  userRole          UserRole
  notificationType  NotificationType
  channel           MessagingChannel
  destination       String?
  status            NotificationDispatchStatus @default(PENDING)
  provider          String
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  metadata          String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime                 @default(now())
  notification      Notification?            @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([channel, status, createdAt])
  @@index([notificationType, createdAt])
  @@index([providerMessageId])
}

model NotificationEmailTemplate {
  id               String           @id @default(cuid())
  key              String           @unique
  name             String
  notificationType NotificationType
  channel          MessagingChannel
  role             UserRole?
  subjectTemplate  String?
  bodyTemplate     String
  bodyHtmlTemplate String?
  bodyTextTemplate String?
  isActive         Boolean          @default(true)
  updatedByEmail   String?
  updatedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  updatedBy        User?            @relation("NotificationEmailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([notificationType, channel, role])
  @@index([notificationType, channel, isActive])
  @@index([role, isActive])
}

model MessagingTemplate {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  channel   MessagingChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  metadata  String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  campaigns MessagingCampaign[]

  @@index([channel, isActive])
}

model MessagingCampaign {
  id              String                  @id @default(cuid())
  name            String
  channel         MessagingChannel
  status          MessagingCampaignStatus @default(DRAFT)
  templateId      String?
  targetRole      UserRole?
  targetCity      City?
  customSubject   String?
  customBody      String
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int                     @default(0)
  totalSent       Int                     @default(0)
  totalFailed     Int                     @default(0)
  createdById     String?
  metadata        String?
  abTestEnabled   Boolean                 @default(false)
  abTestConfig    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  template        MessagingTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy       User?                   @relation("MessagingCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries      MessagingDelivery[]

  @@index([status, channel, createdAt])
  @@index([targetRole, targetCity])
}

model MessagingDelivery {
  id                String                  @id @default(cuid())
  campaignId        String
  userId            String
  channel           MessagingChannel
  destination       String
  status            MessagingDeliveryStatus @default(PENDING)
  provider          String
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  metadata          String?
  abVariant         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  campaign          MessagingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([userId, channel, createdAt])
}

model MessagingOptOut {
  id          String           @id @default(cuid())
  userId      String?
  channel     MessagingChannel
  destination String
  reason      String?
  source      String           @default("user")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([channel, destination])
  @@index([userId, channel, isActive])
}

model MessagingProviderConfig {
  id              String            @id @default(cuid())
  provider        MessagingProvider @unique
  isActive        Boolean           @default(true)
  configEncrypted String
  updatedByEmail  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PwaTelemetryEvent {
  id        String    @id @default(cuid())
  userId    String?
  sessionId String?
  eventName String
  role      UserRole?
  city      City?
  platform  String?
  browser   String?
  source    String?
  metadata  String?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([role, createdAt])
  @@index([city, createdAt])
}

model PwaAdoptionProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  abVariant            String    @default("A")
  promptWindowStartAt  DateTime?
  promptAttemptsWindow Int       @default(0)
  consecutiveDismisses Int       @default(0)
  lastPromptAt         DateTime?
  nextEligibleAt       DateTime?
  deprioritizedUntil   DateTime?
  installedAt          DateTime?
  pushEnabledAt        DateTime?
  lastContext          String?
  lastContextAt        DateTime?
  lastStageShown       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextEligibleAt, deprioritizedUntil])
  @@index([lastContextAt])
  @@index([abVariant])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         City
  postalCode   String?
  instructions String?
  isPrimary    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isPrimary])
}

model RequestPhoto {
  id               String         @id @default(cuid())
  serviceRequestId String
  url              String
  publicId         String?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model VerificationDocument {
  id              String         @id @default(cuid())
  partnerId       String
  type            DocumentType
  documentUrl     String
  publicId        String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  partner         PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([status])
}

model Achievement {
  id          String               @id @default(cuid())
  type        AchievementType      @unique
  name        String
  description String
  icon        String
  level       Int                  @default(1)
  createdAt   DateTime             @default(now())
  partners    PartnerAchievement[]
}

model PartnerAchievement {
  id            String         @id @default(cuid())
  partnerId     String
  achievementId String
  unlockedAt    DateTime       @default(now())
  achievement   Achievement    @relation(fields: [achievementId], references: [id])
  partner       PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, achievementId])
  @@index([partnerId])
}

model PaymentMethod {
  id                String    @id @default(cuid())
  userId            String
  mercadopagoCardId String?   @unique
  cardToken         String?
  lastFourDigits    String
  cardBrand         String
  cardholderName    String
  expirationMonth   Int
  expirationYear    Int
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payments          Payment[]
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mercadopagoCardId])
}

model Payment {
  id                   String            @id @default(cuid())
  bookingId            String            @unique
  userId               String
  paymentMethodId      String?
  mercadopagoId        String?           @unique
  preferenceId         String?
  amount               Float
  serviceAmount        Float
  clientCommission     Float
  clientCommissionRate Float
  totalAmount          Float
  status               PaymentStatus     @default(PENDING)
  paymentMethodType    String?
  paymentType          String?
  transactionAmount    Float?
  netReceivedAmount    Float?
  mercadopagoFee       Float?
  metadata             String?
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  booking              Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentMethod        PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  user                 User              @relation(fields: [userId], references: [id])
  payout               Payout?
  incidents            PaymentIncident[]
  refundCases          RefundCase[]
  taxDocuments         TaxDocument[]

  @@index([userId])
  @@index([status])
  @@index([mercadopagoId])
  @@index([paymentMethodId])
}

model Payout {
  id                    String              @id @default(cuid())
  paymentId             String              @unique
  partnerId             String
  bankAccountId         String?
  amount                Float
  partnerCommission     Float
  partnerCommissionRate Float
  netAmount             Float
  status                PayoutStatus        @default(PENDING)
  externalTransferId    String?
  processorStatus       String?
  processorMessage      String?
  processedBy           String?
  processedAt           DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  partner               PartnerProfile      @relation(fields: [partnerId], references: [id])
  payment               Payment             @relation(fields: [paymentId], references: [id])
  bankAccount           PartnerBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([status])
  @@index([paymentId])
  @@index([bankAccountId])
  @@index([externalTransferId])
}

model PlatformConfig {
  id                    String   @id @default(cuid())
  key                   String   @unique
  commissionRate        Float
  clientCommissionRate  Float    @default(5.0)
  partnerCommissionRate Float    @default(10.0)
  minServicePrice       Float
  maxServicePrice       Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([key])
}

enum UserRole {
  CLIENT
  PARTNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  ACTIVE
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CityConfig {
  id              String          @id @default(cuid())
  name            String          @unique
  slug            String          @unique
  status          CityStatus      @default(ACTIVE)
  order           Int             @default(0)
  latitude        Float?
  longitude       Float?
  isLaunched      Boolean         @default(false)
  launchDate      DateTime?
  partnerRegistry Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  advertisements  Advertisement[]
}

enum CityStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum City {
  MEDELLIN
  BOGOTA
  CALI
  BARRANQUILLA
}

enum NotificationType {
  NEW_SERVICE_REQUEST
  NEW_PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_IN_PROGRESS
  BOOKING_COMPLETED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  ACHIEVEMENT_UNLOCKED
  NEW_MESSAGE
}

enum NotificationAutomationTarget {
  GLOBAL
  CLIENT
  PARTNER
  ADMIN
}

enum NotificationDispatchStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
  UNSUBSCRIBED
  SKIPPED
}

enum DocumentType {
  CEDULA_CIUDADANIA
  CEDULA_EXTRANJERIA
  PASAPORTE
  PEP
  DIPLOMA_BACHILLERATO
  DIPLOMA_TECNICO
  DIPLOMA_TECNOLOGO
  DIPLOMA_PROFESIONAL
  DIPLOMA_POSGRADO
  CERTIFICADO_CURSO
  ANTECEDENTES
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AchievementType {
  IDENTITY_VERIFIED
  EDUCATION_VERIFIED
  BACKGROUND_CHECK_VERIFIED
  FIRST_SERVICE
  TEN_SERVICES
  FIFTY_SERVICES
  HUNDRED_SERVICES
  FIVE_STAR_RATING
  VERIFIED_PARTNER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Chat {
  id               String         @id @default(cuid())
  serviceRequestId String
  proposalId       String         @unique
  clientId         String
  partnerId        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  messages         ChatMessage[]
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  proposal         Proposal       @relation(fields: [proposalId], references: [id])
  client           User           @relation("ClientChats", fields: [clientId], references: [id])
  partner          PartnerProfile @relation("PartnerChats", fields: [partnerId], references: [id])

  @@unique([serviceRequestId, clientId, partnerId])
  @@index([clientId])
  @@index([partnerId])
  @@index([serviceRequestId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
}

model PaymentConfig {
  id                     String             @id @default(cuid())
  environment            PaymentEnvironment @default(TEST)
  testAccessToken        String?
  testPublicKey          String?
  testClientId           String?
  testClientSecret       String?
  productionAccessToken  String?
  productionPublicKey    String?
  productionClientId     String?
  productionClientSecret String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model FavoritePartner {
  id        String         @id @default(cuid())
  userId    String
  partnerId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@index([userId])
  @@index([partnerId])
}

model FavoriteService {
  id        String   @id @default(cuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

model Advertisement {
  id          String      @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  placement   AdPlacement
  serviceId   String?
  cityId      String
  active      Boolean     @default(true)
  startDate   DateTime    @default(now())
  endDate     DateTime?
  priority    Int         @default(0)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city        CityConfig  @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([placement, active, startDate, endDate])
  @@index([serviceId])
  @@index([cityId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PartnerBankAccount {
  id                     String         @id @default(cuid())
  partnerId              String
  bankName               String
  accountType            String
  accountNumber          String
  accountHolderName      String
  holderDocumentType     String
  holderDocumentNumber   String
  city                   String?
  branchCode             String?
  isDefault              Boolean        @default(false)
  isActive               Boolean        @default(true)
  verifiedAt             DateTime?
  mercadoPagoRecipientId String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  partner                PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  payouts                Payout[]

  @@index([partnerId, isDefault, isActive])
  @@index([mercadoPagoRecipientId])
}

model BankCatalog {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  country                String   @default("CO")
  isActive               Boolean  @default(true)
  sortOrder              Int      @default(0)
  accountNumberMinLength Int      @default(8)
  accountNumberMaxLength Int      @default(20)
  supportsSavings        Boolean  @default(true)
  supportsChecking       Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([country, name])
  @@index([country, isActive, sortOrder])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  route      String?
  userAgent  String?
  ipAddress  String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
}

model AdminIncident {
  id             String              @id @default(cuid())
  type           String
  severity       AdminSeverity       @default(MEDIUM)
  status         AdminIncidentStatus @default(OPEN)
  title          String
  description    String?
  source         String
  route          String?
  occurrences    Int                 @default(1)
  firstSeenAt    DateTime            @default(now())
  lastSeenAt     DateTime            @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  metadata       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, severity])
  @@index([lastSeenAt])
}

model SecurityEvent {
  id         String        @id @default(cuid())
  ipAddress  String
  path       String
  method     String
  query      String?
  userAgent  String?
  threatType String
  severity   AdminSeverity @default(MEDIUM)
  source     String        @default("edge-middleware")
  statusCode Int?
  blocked    Boolean       @default(false)
  metadata   String?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
  @@index([ipAddress, createdAt])
  @@index([threatType, severity, createdAt])
}

model BlockedIp {
  id            String    @id @default(cuid())
  ipAddress     String    @unique
  reason        String
  blockSource   String    @default("manual")
  isActive      Boolean   @default(true)
  blockedBy     String?
  blockedAt     DateTime  @default(now())
  expiresAt     DateTime?
  unblockedBy   String?
  unblockedAt   DateTime?
  unblockReason String?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, expiresAt])
  @@index([updatedAt])
}

model AdminSupportCase {
  id              String          @id @default(cuid())
  userId          String?
  role            UserRole?
  bookingId       String?
  requestId       String?
  priority        AdminSeverity   @default(MEDIUM)
  status          AdminCaseStatus @default(OPEN)
  subject         String
  description     String
  assignedTo      String?
  queue           SupportQueue    @default(GENERAL)
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  escalationLevel Int             @default(0)
  lastEscalatedAt DateTime?
  resolutionNote  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  serviceRequest  ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([userId])
  @@index([queue, status, slaDueAt])
}

model PaymentIncident {
  id             String                 @id @default(cuid())
  paymentId      String?
  bookingId      String?
  userId         String?
  partnerId      String?
  incidentType   PaymentIncidentType
  status         PaymentIncidentStatus  @default(OPEN)
  severity       AdminSeverity          @default(MEDIUM)
  source         String                 @default("system")
  title          String
  description    String
  rootCause      String?
  assignedTo     String?
  slaDueAt       DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  metadata       String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  payment        Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  booking        Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner        PartnerProfile?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  events         PaymentIncidentEvent[]

  @@index([status, severity, createdAt])
  @@index([incidentType, status])
  @@index([paymentId])
  @@index([bookingId])
}

model PaymentIncidentEvent {
  id         String          @id @default(cuid())
  incidentId String
  actorEmail String?
  action     String
  note       String?
  metadata   String?
  createdAt  DateTime        @default(now())
  incident   PaymentIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model RefundCase {
  id               String          @id @default(cuid())
  bookingId        String?
  paymentId        String?
  userId           String?
  partnerId        String?
  reason           String
  policyCode       String?
  status           RefundStatus    @default(REQUESTED)
  requestedAmount  Float
  approvedAmount   Float?
  currency         String          @default("COP")
  requestedBy      String?
  reviewedBy       String?
  reviewNotes      String?
  processedAt      DateTime?
  externalRefundId String?
  metadata         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner          PartnerProfile? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([bookingId])
  @@index([paymentId])
}

model ComplianceRule {
  id                String                 @id @default(cuid())
  key               String                 @unique
  name              String
  description       String
  ruleType          ComplianceRuleType
  enabled           Boolean                @default(true)
  country           String                 @default("CO")
  city              City?
  serviceSlug       String?
  partnerRole       UserRole?              @default(PARTNER)
  riskThreshold     Int?
  requiredDocuments String?
  metadata          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  evaluations       ComplianceEvaluation[]

  @@index([enabled, country, city])
}

model ComplianceEvaluation {
  id          String                     @id @default(cuid())
  partnerId   String
  userId      String?
  ruleId      String?
  status      ComplianceEvaluationStatus
  score       Int                        @default(0)
  findings    String
  evaluatedBy String                     @default("system")
  evaluatedAt DateTime                   @default(now())
  expiresAt   DateTime?
  metadata    String?
  partner     PartnerProfile             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user        User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  rule        ComplianceRule?            @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([partnerId, evaluatedAt])
  @@index([status, evaluatedAt])
}

model TaxDocument {
  id                String            @id @default(cuid())
  documentNumber    String            @unique
  type              TaxDocumentType
  status            TaxDocumentStatus @default(PENDING)
  paymentId         String?
  userId            String?
  subtotalAmount    Float
  taxAmount         Float             @default(0)
  withholdingAmount Float             @default(0)
  totalAmount       Float
  currency          String            @default("COP")
  issueDate         DateTime?
  dueDate           DateTime?
  sentAt            DateTime?
  generatedBy       String?
  metadata          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payment           Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([paymentId])
}

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  description       String?
  enabled           Boolean   @default(false)
  rolloutPercentage Int       @default(100)
  targetRole        UserRole?
  targetCity        City?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CmsEntry {
  id          String    @id @default(cuid())
  key         String    @unique
  title       String
  content     String
  status      CmsStatus @default(DRAFT)
  updatedBy   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OperationalRule {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  enabled       Boolean  @default(true)
  threshold     Int
  windowMinutes Int      @default(5)
  metadata      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FraudSignal {
  id         String              @id @default(cuid())
  userId     String?
  partnerId  String?
  bookingId  String?
  type       String
  severity   AdminSeverity       @default(MEDIUM)
  status     AdminIncidentStatus @default(OPEN)
  score      Int                 @default(0)
  reason     String
  details    String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  partner    PartnerProfile?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  booking    Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([score])
}

enum AdPlacement {
  HOME
  SERVICE
}

enum PaymentEnvironment {
  TEST
  PRODUCTION
}

enum AdminSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AdminIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AdminCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportQueue {
  GENERAL
  PAYMENTS
  REFUNDS
  RISK
  KYC
}

enum PaymentIncidentType {
  PAYMENT_FAILURE
  CHARGEBACK
  REFUND_DISPUTE
  PAYOUT_FAILURE
}

enum PaymentIncidentStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum ComplianceRuleType {
  DOCUMENT_REQUIRED
  RISK_SCORE_THRESHOLD
  CITY_RESTRICTION
  SERVICE_RESTRICTION
}

enum ComplianceEvaluationStatus {
  PASS
  WARNING
  FAIL
}

enum TaxDocumentType {
  INVOICE
  CREDIT_NOTE
  WITHHOLDING_CERTIFICATE
}

enum TaxDocumentStatus {
  PENDING
  GENERATED
  SENT
  CANCELLED
  ERROR
}

enum CmsStatus {
  DRAFT
  PUBLISHED
}

enum MessagingChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum MessagingCampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

enum MessagingDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
  CLICKED
  UNSUBSCRIBED
}

enum MessagingProvider {
  TWILIO
  SENDGRID
}
