  state               String           @unique
  channel             MessagingChannel
  adminId             String
  workspaceId         String
  status              String           @default("pending")
  candidatesEncrypted String?
  options             Json?
  error               String?
  expiresAt           DateTime
  createdAt           DateTime         @default(now())
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

